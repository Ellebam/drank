# ---- Quell-Fotos (eure eigenen Aufnahmen – NICHT auf die Website) ----
# Eigene Handy-/Kamerafotos zum Identifizieren von Getränken.
# Auf der Website werden ausschließlich hochwertige Bilder aus dem
# Internet (in assets/images/) verwendet – nie diese Quell-Fotos.
source-photos/
quellfotos/
*.HEIC
*.heic
*.HEIF
*.heif

# ---- Claude Code ----
# settings.json wird BEWUSST committet (geteilte Projekt-Config für den
# Handy-Workflow). Nur lokale/maschinenspezifische Dateien ausschließen:
.claude/settings.local.json
.claude/*.lock
.claude/shell-snapshots/
.claude/todos/
.claude/projects/
.claude/statsig/
.claude/.credentials.json

